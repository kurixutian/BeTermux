<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <com.termux.shared.termux.extrakeys.ExtraKeysView
        android:id="@+id/terminal_toolbar_extra_keys"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <ImageButton
        android:id="@+id/btn_extra_keys_upload_image"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Upload / Paste Image"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_gallery"
        android:tint="@color/nt_toolbar_icon" />

</LinearLayout>
