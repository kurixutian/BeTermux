<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/newtermux_toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/nt_toolbar_bg">

    <!-- Top bar: app name + feature buttons -->
    <LinearLayout
        android:id="@+id/newtermux_toolbar_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Static App Icon at top leftmost of header (no function, purely visual) -->
        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:clickable="false"
            android:focusable="false"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Files Button (In-App File Manager & Editor) -->
        <TextView
            android:id="@+id/btn_files"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_package_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Files"
            android:textColor="@color/nt_on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Autocorrect Toggle Button -->
        <TextView
            android:id="@+id/btn_autocorrect_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_package_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="AC"
            android:textColor="@color/nt_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Packages Button -->
        <TextView
            android:id="@+id/btn_packages_menu"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_package_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Packages"
            android:textColor="@color/nt_on_surface"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Clear Button -->
        <TextView
            android:id="@+id/btn_clear_terminal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_package_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Clear"
            android:textColor="@color/nt_on_surface"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Speech-to-Text button -->
        <ImageButton
            android:id="@+id/btn_stt"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Speech to Text"
            android:src="@drawable/ic_mic"
            android:tint="@color/nt_stt_idle"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- Settings button -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/nt_toolbar_icon"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- Extra Keys Toggle Button (Show/Hide Quick Keyboard) -->
        <ImageButton
            android:id="@+id/btn_extra_keys"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Extra Keys"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/nt_toolbar_icon"
            android:padding="8dp" />

        <!-- New session button -->
        <ImageButton
            android:id="@+id/btn_new_session"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New Session"
            android:src="@drawable/ic_add_session"
            android:tint="@color/nt_toolbar_icon"
            android:padding="8dp" />

        <!-- More options menu button -->
        <ImageButton
            android:id="@+id/btn_more_menu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More Options"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/nt_toolbar_icon"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nt_divider" />

    <!-- 1-row columned tab strip (terminal, browser, and file tabs) -->
    <HorizontalScrollView
        android:id="@+id/session_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:scrollbars="none"
        android:background="@color/nt_tab_bg">

        <LinearLayout
            android:id="@+id/session_pip_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- Bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nt_divider" />

</LinearLayout>
